{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage Dock",
  "version": "0.1.2",
  "identifier": "com.aiusagedock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Usage Dock",
        "width": 300,
        "height": 270,
        "minWidth": 260,
        "minHeight": 160,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": true,
        "center": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false
  }
}
